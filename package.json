{
  "name": "vibing-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Watch Claude Code write code, live, with its reasoning alongside.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "dev": "node tools/build.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check-viewer": "node tools/check-viewer.ts",
    "demo": "node tools/record-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "dompurify": "^3.4.18"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
